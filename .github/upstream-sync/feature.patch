+    if (entry._tag === "Die" && isProtocolError(entry.defect)) {
+      changed = true;
+      return { _tag: "Fail" as const, error: entry.defect };
+    }
+    return entry;
+  });
+  return changed ? { ...message, exit: { _tag: "Failure", cause } } : message;
+}
