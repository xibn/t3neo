@@ -0,0 +1,230 @@
+---
+permalink: /
+redirect_from:
+  - /download/
+---
+
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Download T3 Neo</title>
+    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
+    <meta name="robots" content="noindex" />
+    <style>
+      :root {
+        color-scheme: dark;
+        --bg: #110f0d;
+        --card: #171412;
+        --border: rgb(255 237 217 / 10%);
+        --ink: #ffedd9;
+        --muted: #a4958a;
+        --accent: #f2a26e;
+      }
+      * {
+        box-sizing: border-box;
+      }
+      body {
+        margin: 0;
+        min-height: 100vh;
+        display: grid;
+        place-items: center;
+        background: var(--bg)
+          radial-gradient(60rem 30rem at 50% -10rem, rgb(242 162 110 / 8%), transparent 70%);
+        color: var(--ink);
+        font-family:
+          "Schibsted Grotesk", "Inter Tight", Inter, "Helvetica Neue", Helvetica, Arial, system-ui,
+          sans-serif;
+        letter-spacing: -0.005em;
+      }
+      main {
+        width: min(92vw, 520px);
+        padding: 32px;
+        border: 1px solid var(--border);
+        border-radius: 20px;
+        background: var(--card);
+        box-shadow: 0 30px 60px -40px rgb(0 0 0 / 80%);
+      }
+      h1 {
+        margin: 0 0 8px;
+        font-size: 28px;
+        font-weight: 300;
+        letter-spacing: -0.03em;
+      }
+      p {
+        margin: 0 0 20px;
+        color: var(--muted);
+        line-height: 1.5;
+      }
+      .button {
+        display: inline-flex;
+        align-items: center;
+        gap: 10px;
+        padding: 12px 20px;
+        border-radius: 999px;
+        border: 1px solid transparent;
+        background: var(--accent);
+        color: #1b120a;
+        font-weight: 600;
+        text-decoration: none;
+      }
+      .button.secondary {
+        background: transparent;
+        border-color: var(--border);
+        color: var(--ink);
+      }
+      .row {
+        display: flex;
+        flex-wrap: wrap;
+        gap: 10px;
+        align-items: center;
+      }
+      .label {
+        margin-top: 18px;
+        font-size: 11px;
+        font-weight: 600;
+        letter-spacing: 0.08em;
+        text-transform: uppercase;
+        color: var(--muted);
+      }
+      ul {
+        margin: 8px 0 0;
+        padding: 0;
+        list-style: none;
+        display: grid;
+        gap: 6px;
+      }
+      li a {
+        color: var(--ink);
+        text-decoration: none;
+        border-bottom: 1px solid var(--border);
+      }
+      code {
+        font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
+        font-size: 12px;
+        color: var(--muted);
+      }
+      .repo {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.35em;
+        color: inherit;
+        text-decoration: none;
+      }
+      .repo:hover {
+        color: var(--accent);
+      }
+      .repo svg {
+        width: 1em;
+        height: 1em;
+        fill: currentColor;
+      }
+    </style>
+  </head>
+  <body>
+    <main>
+      <h1>Download T3 Neo</h1>
+      <p id="status">Looking up the latest release for your system…</p>
+      <div class="row">
+        <a class="button" id="primary" href="../../releases/latest" rel="noopener">Download</a>
+        <a class="button secondary" id="all" href="../../releases/latest" rel="noopener"
+          >All releases</a
+        >
+      </div>
+      <div class="label">Other platforms</div>
+      <ul id="others"></ul>
+      <p style="margin-top: 20px"><code id="meta"></code></p>
+    </main>
+    <script>
+      // Self-contained: this page is served from the repository's GitHub Pages,
+      // so the repository slug comes from the page's own URL
+      // (https://OWNER.github.io/REPO/). A "repo" query overrides it.
+      const GITHUB_MARK =
+        '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>';
+      (async () => {
+        const params = new URLSearchParams(location.search);
+        const host = location.hostname;
+        const pathRepo = location.pathname.split("/").filter(Boolean)[0];
+        const owner = host.endsWith(".github.io") ? host.slice(0, -".github.io".length) : null;
+        const repo =
+          params.get("repo") ?? (owner && pathRepo ? `${owner}/${pathRepo}` : "xibn/t3neo");
+        const releasesUrl = `https://github.com/${repo}/releases`;
+        const status = document.getElementById("status");
+        const primary = document.getElementById("primary");
+        const all = document.getElementById("all");
+        const others = document.getElementById("others");
+        const meta = document.getElementById("meta");
+        all.href = `${releasesUrl}/latest`;
+        primary.href = `${releasesUrl}/latest`;
+
+        const ua = navigator.userAgent.toLowerCase();
+        const platform = (navigator.platform || "").toLowerCase();
+        const detected =
+          platform.startsWith("win") || ua.includes("windows")
+            ? "windows"
+            : platform.startsWith("linux") || ua.includes("linux")
+              ? "linux"
+              : platform.startsWith("mac") || ua.includes("mac os")
+                ? "mac-arm64"
+                : "unknown";
+        const labels = {
+          "mac-arm64": "macOS (Apple silicon)",
+          "mac-x64": "macOS (Intel)",
+          linux: "Linux (AppImage)",
+          windows: "Windows",
+        };
+        const matchers = {
+          "mac-arm64": (n) => n.endsWith(".dmg") && n.includes("arm64"),
+          "mac-x64": (n) => n.endsWith(".dmg") && n.includes("x64"),
+          linux: (n) => n.endsWith(".appimage"),
+          windows: (n) => n.endsWith(".exe"),
+        };
+
+        try {
+          const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
+            headers: { Accept: "application/vnd.github+json" },
+          });
+          if (!response.ok) throw new Error(`GitHub responded with ${response.status}`);
+          const release = await response.json();
+          const assets = Array.isArray(release.assets) ? release.assets : [];
+          const pick = (key) =>
+            assets.find((asset) => matchers[key](String(asset.name).toLowerCase())) ?? null;
+          const mine = detected === "unknown" ? null : pick(detected);
+          if (mine) {
+            primary.href = mine.browser_download_url;
+            primary.textContent = `Download for ${labels[detected]}`;
+            status.textContent = `T3 Neo ${release.tag_name}, built for ${labels[detected]}.`;
+          } else {
+            primary.textContent = "Open the latest release";
+            status.textContent = `T3 Neo ${release.tag_name}. Pick your platform below.`;
+          }
+          for (const key of Object.keys(labels)) {
+            if (key === detected && mine) continue;
+            const asset = pick(key);
+            if (!asset) continue;
+            const item = document.createElement("li");
+            const link = document.createElement("a");
+            link.href = asset.browser_download_url;
+            link.textContent = `${labels[key]} · ${asset.name}`;
+            item.appendChild(link);
+            others.appendChild(item);
+          }
+          const repoLink = document.createElement("a");
+          repoLink.className = "repo";
+          repoLink.href = `https://github.com/${repo}`;
+          repoLink.innerHTML = GITHUB_MARK;
+          repoLink.append(document.createTextNode(repo));
+          meta.replaceChildren(
+            repoLink,
+            ` · published ${new Date(release.published_at).toLocaleDateString()}`,
+          );
+          if (mine && params.get("auto") === "1") location.href = mine.browser_download_url;
+        } catch (error) {
+          status.textContent = `Could not read the latest release (${error.message}). Opening the releases page works too.`;
+          primary.textContent = "Open releases";
+        }
+      })();
+    </script>
+  </body>
+</html>
